# Enlace de Cal.com con formato "usuario/evento". Ejemplo: giulianazitella/llamada
# Sin esta variable, la sección "Charlemos 20 minutos" muestra una agenda de
# muestra que deriva a WhatsApp con el día y la hora elegidos.
NEXT_PUBLIC_CAL_LINK=

# OPCIONAL. URL pública del sitio, solo para los metadatos de Open Graph.
# Si no se define, se usa la URL que Vercel expone para el deploy y, fuera de
# Vercel, gztraining.com.ar. No la dejes definida y vacía en el panel de
# Vercel: borrala del proyecto o cargale el dominio real.
# NEXT_PUBLIC_SITE_URL=https://gztraining.com.ar
